{
  "name": "meet-ai",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun --filter '*' test",
    "fmt": "oxfmt **/*.{ts,tsx}",
    "fmt:check": "oxfmt --check **/*.{ts,tsx}",
    "lint": "oxlint -f json",
    "lint-changed": "oxlint $(git diff --name-only) -f json",
    "lint-changed:fix": "oxlint $(git diff --name-only) --fix -f json",
    "lint-staged": "oxlint $(git diff --cached --name-only) -f json",
    "lint-staged:fix": "oxlint $(git diff --cached --name-only) --fix -f json",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "catalog:"
  },
  "catalog": {
    "@base-ui/react": "1.4.1",
    "@cloudflare/workers-types": "4.20260509.1",
    "@elevenlabs/elevenlabs-js": "2.46.0",
    "@hono/zod-validator": "0.8.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query": "5.100.9",
    "@types/bun": "1.3.13",
    "@types/node": "25.0.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "hono": "4.12.18",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vitest": "4.1.5",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  }
}
