{
  "name": "@meet-ai/cli",
  "version": "2.5.3",
  "description": "CLI for meet-ai chat rooms — create rooms, send messages, and stream via WebSocket",
  "keywords": [
    "chat",
    "cli",
    "meet-ai",
    "real-time",
    "websocket"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftWare-A-G/meet-ai.git",
    "directory": "packages/cli"
  },
  "bin": {
    "meet-ai": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "generate:app-server-types": "codex app-server generate-ts --experimental --out src/generated/codex-app-server",
    "build": "rm -rf dist && bun build src/index.ts --production --outdir dist --target node --format esm",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@opencode-ai/sdk": "1.14.42",
    "@sinclair/typebox": "0.34.49",
    "@tldraw/tlschema": "5.0.0",
    "better-result": "2.9.2",
    "citty": "0.2.2",
    "evlog": "2.16.0",
    "hono": "4.12.18",
    "ink": "7.0.2",
    "ink-link": "5.0.0",
    "picocolors": "1.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tldraw": "5.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@meet-ai/domain": "workspace:*",
    "@types/bun": "1.3.13",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
